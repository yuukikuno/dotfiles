[/]
custom-list=['custom0', 'custom1', 'custom2', 'custom3', 'custom4', '__dummy__']

[custom-keybindings/custom0]
binding=['<Alt>h']
command='/home/yuuki/.local/bin/hints'
name='hints'

[custom-keybindings/custom1]
binding=['Print']
command='/usr/bin/flameshot gui'
name='flameshot'

[custom-keybindings/custom2]
binding=['<Alt>d']
command='/home/yuuki/.local/bin/hints --mode scroll'
name='hints scroll'

[custom-keybindings/custom3]
binding=['<Primary><Alt>t']
command='.local/bin/ghostty-toggle.fish'
name='ghostty'

[custom-keybindings/custom4]
binding=['<Primary><Alt>n']
command='ghostty -e nvim'
name='nvim'

[media-keys]
play=['Favorites']
screensaver=['<Super>l']
screenshot=@as []
touchpad-off=@as []
touchpad-toggle=['TouchpadOff']
